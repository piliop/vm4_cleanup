# Copy this file to a private .env outside public_html and update every value.
# Full-line comments are supported; do not add inline comments to values.
VM4_WEB_PASSWORD=replace-this-with-a-unique-random-password-at-least-16-chars
VM4_ALLOW_HTTP_LOCALHOST=false

# Each site key needs a LABEL, TABLE_PREFIX, DB_DSN, DB_USERNAME, DB_PASSWORD,
# AUDIT_DB, and one or more MEDIA_ROOT_N entries.
VM4_SITE_SHOP_ONE_LABEL=Shop one
VM4_SITE_SHOP_ONE_TABLE_PREFIX=jml_
VM4_SITE_SHOP_ONE_DB_DSN="mysql:host=localhost;dbname=joomla;charset=utf8mb4"
VM4_SITE_SHOP_ONE_DB_USERNAME=cleanup_user
VM4_SITE_SHOP_ONE_DB_PASSWORD=replace-this
VM4_SITE_SHOP_ONE_AUDIT_DB=/home/account/private/vm4-cleanup/shop-one.sqlite
VM4_SITE_SHOP_ONE_MEDIA_ROOT_1=/home/account/public_html/images/virtuemart

VM4_SITE_SHOP_TWO_LABEL=Shop two
VM4_SITE_SHOP_TWO_TABLE_PREFIX=shop2_
VM4_SITE_SHOP_TWO_DB_DSN="mysql:host=localhost;dbname=joomla_shop_two;charset=utf8mb4"
VM4_SITE_SHOP_TWO_DB_USERNAME=cleanup_user_two
VM4_SITE_SHOP_TWO_DB_PASSWORD=replace-this
VM4_SITE_SHOP_TWO_AUDIT_DB=/home/account/private/vm4-cleanup/shop-two.sqlite
VM4_SITE_SHOP_TWO_MEDIA_ROOT_1=/home/account/shop-two/public_html/images/virtuemart
